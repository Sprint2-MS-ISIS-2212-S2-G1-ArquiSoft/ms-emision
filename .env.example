# Aplicacion
NODE_ENV=development
PORT=3000
EMISION_NAME=emision
REPLICA_ID=emision-1

# BD Emision (PostgreSQL). DB_PORT=5438 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5438
DB_USER=emision
DB_PASSWORD=emision
DB_NAME=emision
DB_LOGGING=false

# true en local (crea las tablas). En AWS: false, el esquema lo crea database/init.sql.
DB_SYNCHRONIZE=true
# true en AWS: RDS PostgreSQL 16 exige SSL.
DB_SSL=false
# Conexiones maximas del pool POR REPLICA (replicas max x DB_POOL_MAX <= max_connections de RDS).
DB_POOL_MAX=10

# ---- ASR de disponibilidad: Suscripcion y emision resiliente de polizas ----
# false = linea base sin Graceful Shutdown ni tolerancia en sondas, usando la misma imagen.
RESILIENCIA_HABILITADA=true
# Tiempo (ms) que la replica espera tras marcar /health/readiness en 503 antes de cerrar el pool de BD.
SHUTDOWN_DRAIN_MS=5000
# Timeout (ms) de SELECT 1 en el Readiness Probe contra PostgreSQL.
READINESS_DB_TIMEOUT_MS=1500

# ---- Simulacion de fallos para el experimento ----
# Modos: normal | lento | caido | readiness_fallido | liveness_fallido
SIMULAR_MODO=normal
SIMULAR_LATENCIA_MS=0
SIMULACION_ADMIN_HABILITADA=true
